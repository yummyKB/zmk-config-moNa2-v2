#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 4 ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E       &kp R                        &kp T                                                              &kp Y         &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D       &kp F                        &kp G                                      &kp F13                 &kp H         &kp J  &kp K      &kp L    &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X         &kp C       &kp V                        &kp B            &kp ESC                   &kp F15                 &kp N         &kp M  &kp COMMA  &kp DOT  &kp SLASH
&mt LCTRL TAB     &kp LEFT_WIN  &lt 6 CAPS  &lt_to_layer_0 3 LANGUAGE_2  &lt 2 BACKSPACE  &lt_to_layer_0 1 LANG1    &lt_to_layer_0 4 SPACE  &lt 5 RETURN                             &kp LEFT_ALT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp SLASH     &kp N7     &kp N8    &kp N9  &kp MINUS                    &kp LEFT         &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT             &kp UNDERSCORE
&kp ASTERISK  &kp N4     &kp N5    &kp N6  &kp DOT              &trans  &kp EXCLAMATION  &kp AT_SIGN     &kp HASH      &kp DOLLAR            &kp PERCENT
&kp ENTER     &kp N1     &kp N2    &kp N3  &kp N0     &trans    &trans  &kp LCTRL        &kp AMPERSAND   &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans        &kp EQUAL  &kp PLUS  &trans  &trans     &trans    &trans  &trans                                                               &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            bindings = <
&kp LA(NUMBER_2)  &kp LA(N5)   &kp LC(F8)        &kp LS(F4)        &kp LC(N5)                                   &kp GRAVE  &kp TILDE  &kp BACKSLASH  &kp PIPE          &kp UNDERSCORE
&kp LC(F11)       &kp LC(F12)  &kp LA(NUMBER_3)  &kp LS(F5)        &kp RC(NUMBER_2)             &msc SCRL_UP    &mkp MB3   &mkp MB1   &mkp MB2       &kp EQUAL         &kp PLUS
&kp LC(N7)        &kp LC(F9)   &kp LA(NUMBER_4)  &kp LA(NUMBER_6)  &kp LC(F10)       &kp F11    &msc SCRL_DOWN  &kp GRAVE  &kp SQT    &kp BSLH       &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans            &kp LA(F1)   &kp LS(F12)       &trans            &trans            &trans     &trans          &trans                                                 &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&kp LA(N8)          &kp LC(LS(LA(NUMBER_1)))  &kp LS(LA(LC(N5)))        &kp LC(LA(LS(N7)))  &kp LC(LS(LA(N9)))                      &trans  &kp HOME        &kp UP_ARROW    &kp END          &trans
&kp LA(N9)          &kp LS(LA(LC(NUMBER_2)))  &kp LS(LA(LC(NUMBER_6)))  &kp LC(LS(LA(N8)))  &kp LA(LS(NUMBER_4))            &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&kp LS(LA(LC(N0)))  &kp LA(LS(LC(NUMBER_3)))  &kp LG(LS(LEFT_ARROW))    &kp LS(F11)         &kp LS(LA(F1))        &trans    &trans  &trans  &kp DELETE      &kp PAGE_UP     &kp PAGE_DOWN    &trans
&trans              &kp LA(F11)               &kp LA(F12)               &trans              &trans                &trans    &trans  &trans                                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_4 {
            bindings = <
&trans  &kp LS(F4)   &kp LA(LC(F7))  &kp LC(LA(F3))  &kp LA(F10)                             &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &kp LS(F5)   &kp LA(LC(F8))  &kp LC(LA(F4))  &kp LC(LS(F11))            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans       &kp LA(LC(F9))  &kp LA(LC(F5))  &kp LC(LS(F12))  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &kp LA(F11)  &kp F8          &trans          &trans           &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans          &trans    &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &mkp MB3  &msc SCRL_UP    &mkp MB1  &trans            &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &trans    &msc SCRL_DOWN  &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans    &trans          &trans    &trans  &trans    &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                     &trans  &trans  &trans  &trans  &trans
&kp F6  &kp F7  &kp F8  &kp F9  &kp F10            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans   &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans   &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
